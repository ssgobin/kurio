{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4175",
      "startServerReadyPattern": "Local",
      "url": [
        "http://127.0.0.1:4175/",
        "http://127.0.0.1:4175/nft/emerald-ape-042"
      ],
      "numberOfRuns": 3,
      "settings": {"preset": "desktop", "formFactor": "desktop", "screenEmulation": {"mobile": false, "width": 1440, "height": 1000, "deviceScaleFactor": 1, "disabled": false}}
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "categories:seo": ["error", {"minScore": 0.9}]
      }
    },
    "upload": {"target": "filesystem", "outputDir": "./reports/lighthouse/desktop"}
  }
}
